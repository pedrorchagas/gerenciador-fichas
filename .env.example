JWT_SECRET=

# Senha de convite pra criar conta de operador (POST /auth/register).
# Obrigatória: sem ela preenchida, ninguém consegue se cadastrar.
REGISTER_SECRET=

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Banco: PostgreSQL instalado na própria VM (ver docs/magalu-setup.md).
# Formato: postgres://usuario:senha@localhost:5432/nome-do-banco
# Senha com caractere especial (@ / : # ?) precisa de URL-encode.
DATABASE_URL=
# false quando o Postgres é local (não há rede pra interceptar).
# Deixe VAZIO se um dia mudar pra um banco remoto/DBaaS — aí o TLS é obrigatório.
DB_SSL=false

ITEMS_TABLE=fichas_itens
ORDERS_TABLE=fichas_pedidos
USERS_TABLE=fichas_usuarios

# Object Storage da Magalu (compatível com S3). As imagens do cardápio são
# exibidas sem autenticação; o upload já sobe cada objeto com ACL public-read.
MGC_REGION=br-se1
MGC_BUCKET=
MGC_ACCESS_KEY_ID=
MGC_SECRET_ACCESS_KEY=
# DEIXE VAZIO. Só existe pra apontar pra outro provedor S3. NÃO cole aqui a URL
# do bucket que o console mostra (https://<bucket>.br-se1.magaluobjects.com):
# o bucket entra duas vezes na URL da imagem e o navegador leva 403.
MGC_ENDPOINT=
